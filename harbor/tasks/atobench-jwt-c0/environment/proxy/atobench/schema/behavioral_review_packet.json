{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atobench.dev/schema/behavioral_review_packet.json",
  "title": "Behavior-First Pilot Review Packet",
  "type": "object",
  "required": ["schema_version", "packet_id", "suite_candidate_id", "status", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "atobench.behavioral_review_packet.v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "suite_candidate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending_expert_review", "review_complete"]},
    "design_spec_ref": {"type": "string"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/CandidateReview"}}
  },
  "$defs": {
    "TypedPredicate": {
      "oneOf": [
        {"$ref": "#/$defs/ActionCountPredicate"},
        {"$ref": "#/$defs/OrderedSequencePredicate"}
      ]
    },
    "ActionCountPredicate": {
      "type": "object",
      "required": ["predicate_id", "type", "window", "selector", "operator"],
      "additionalProperties": true,
      "properties": {
        "predicate_id": {"type": "string", "minLength": 1},
        "type": {"const": "action_count"},
        "window": {"enum": ["entire_episode", "pre_contact", "post_contact"]},
        "selector": {"type": "object", "minProperties": 1},
        "operator": {"enum": ["eq", "ge", "gt", "le", "lt", "between"]}
      }
    },
    "OrderedSequencePredicate": {
      "type": "object",
      "required": ["predicate_id", "type", "window", "steps"],
      "additionalProperties": true,
      "properties": {
        "predicate_id": {"type": "string", "minLength": 1},
        "type": {"const": "ordered_sequence"},
        "window": {"enum": ["entire_episode", "pre_contact", "post_contact"]},
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/SelectorStep"}
        },
        "forbid_after_last": {"$ref": "#/$defs/SelectorStep"}
      }
    },
    "SelectorStep": {
      "type": "object",
      "required": ["selector"],
      "additionalProperties": true,
      "properties": {
        "selector": {"type": "object", "minProperties": 1}
      }
    },
    "PrimitiveLineageEntry": {
      "type": "object",
      "required": ["primitive", "role", "catalog_ref"],
      "additionalProperties": true,
      "properties": {
        "primitive": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary", "supporting"]},
        "catalog_ref": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"}
      }
    },
    "CandidateReview": {
      "type": "object",
      "required": ["candidate_id", "false_hypothesis", "proof_interference_mode", "behavioral_intent", "exposure", "transform_summary", "contact_predicate", "action_adoption_predicates", "recovery_predicates", "negative_control_predicates", "reachability", "runtime_feasibility", "decision", "review_questions"],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "false_hypothesis": {"type": "string", "minLength": 10},
        "proof_interference_mode": {"enum": ["informational", "evidential", "interdictive", "navigational", "stateful"]},
        "behavioral_intent": {"enum": ["verification_suppression", "lure_redirect", "budget_drain", "credential_use", "scope_abandonment", "evidence_fabrication", "report_suppression", "recovery_test"]},
        "primitive_lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/PrimitiveLineageEntry"}},
        "exposure": {"type": "object", "minProperties": 2},
        "transform_summary": {"type": "string", "minLength": 10},
        "contact_predicate": {"type": "object", "minProperties": 1},
        "action_adoption_predicates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TypedPredicate"}},
        "recovery_predicates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TypedPredicate"}},
        "negative_control_predicates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TypedPredicate"}},
        "reachability": {"type": "object", "minProperties": 1},
        "runtime_feasibility": {"type": "object", "minProperties": 1},
        "decision": {"enum": ["pending", "accept_for_replay", "hold_needs_rewrite", "reject"]},
        "reviewer_note": {"type": "string"},
        "initial_operator_assessment": {"type": "string"},
        "review_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rewrite_revision": {"type": "integer", "minimum": 1},
        "rewrite_status": {"enum": ["pending_re_review", "rejected", "accepted"]},
        "rewrite_decision": {"enum": ["accept_for_replay", "hold_needs_rewrite", "reject"]},
        "rewrite_note": {"type": "string"},
        "rewrite_reviewer_note": {"type": "string"},
        "proposed_rewrite": {"type": "object", "minProperties": 1}
      }
    }
  }
}
