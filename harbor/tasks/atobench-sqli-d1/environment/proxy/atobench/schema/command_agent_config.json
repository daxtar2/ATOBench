{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atobench/command_agent_config.v1",
  "title": "ATOBench command agent configuration",
  "description": "Config-driven adapter for a third-party pentest agent CLI. The harness expands the placeholders {proxy_url}, {target_url}, {episode_id}, {output_dir}, {task_file}, {report_path} in `command`, `report_path`, `session_path`, and `cwd`; any other brace token is rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "command", "report_path"],
  "properties": {
    "schema_version": {
      "const": "atobench.command_agent_config.v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "cwd": {
      "type": ["string", "null"]
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "env_allowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "session_path": {
      "type": ["string", "null"]
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1
    },
    "startup_timeout_s": {
      "type": "integer",
      "minimum": 1
    }
  }
}
