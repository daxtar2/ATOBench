{
  "schema_version": "atobench.claude_judge_runner_config.v1",
  "claude_executable": "claude",
  "model": "glm-5.2",
  "fallback_model": null,
  "effort": "high",
  "timeout_seconds": 900,
  "max_budget_usd_per_call": null,
  "permission_mode": "dontAsk",
  "tools": ["Read"],
  "output_format": "json",
  "no_session_persistence": true,
  "disable_slash_commands": true,
  "no_chrome": true,
  "setting_sources": ["user", "project"],
  "strict_empty_mcp_config": true,
  "reviewer_ids": ["trajectory_judge_a", "trajectory_judge_b"],
  "alignment_verifier_ids": ["alignment_verifier_a", "alignment_verifier_b"],
  "parallel_reviewers": true,
  "temperature": "not_exposed_by_claude_code_cli",
  "reviewer_semantics": "isolated_replicate_reviewers_same_model_revision",
  "network_policy": "no_web_tools_exposed",
  "filesystem_policy": "read_only_packet_workspace"
}
